# AI provider: never put this key in frontend JavaScript or share it publicly.
OPENAI_API_KEY=replace_with_your_private_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Comma-separated RSS/Atom feed URLs from sources you trust.
# Example format: https://example.com/rss.xml,https://another.example/feed
NEWS_FEEDS=

# Optional JSON endpoint for verified economic indicators.
# Expected response may be any JSON object; define its schema with your data provider.
ECONOMIC_DATA_URL=

REQUEST_TIMEOUT=20
HOST=127.0.0.1
PORT=8000

# Account security (set a long random value; do not publish .env)
SECRET_KEY=replace_with_a_long_random_secret
COOKIE_SECURE=0

# Initial administrator is created on first startup when both values are set.
# Use a strong password (at least 16 characters) and change it outside this app if exposed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Optional path for SQLite database
# DATABASE_PATH=./business_key.db
